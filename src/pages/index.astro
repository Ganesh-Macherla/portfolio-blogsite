---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getProjects } from "@/utils/getProjects";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, SITE.postPerIndex);

const projects = await getProjects();
const featuredProjects = projects.slice(0, 4);
---

<Layout>
  <Header />

  <main
    id="main-content"
    class="app-layout py-12"
  >
    <!-- Hero Section -->
    <section class="mb-20">
      <h1 class="text-6xl font-extrabold tracking-tight">
        Quiet Commits
      </h1>

      <p class="mt-6 max-w-3xl text-lg text-gray-400 leading-8">
        Greetings, explorer of the internet, and welcome to my domain.
        A place where I document projects, write random thoughts,
        overthink life decisions, and continuously convince myself
        that everything will work out if I stay motivated.
        Meanwhile, deadlines pile up, my sleep schedule collapses,
        and my sanity slowly descends into chaos.
        But hey, it's fun. I promise :D
      </p>
    </section>

    <!-- Recent Posts -->
    <section class="mb-24">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-3xl font-bold">
          Recent Posts
        </h2>

        <a
          href="/astro-paper/posts"
          class="text-orange-500 hover:text-orange-400"
        >
          View All →
        </a>
      </div>

      <ul class="space-y-8">
        {
          recentPosts.map(post => (
            <Card {...post} />
          ))
        }
      </ul>
    </section>

    <!-- Featured Projects -->
    <section>
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-3xl font-bold">
          Featured Projects
        </h2>

        <a
          href="/astro-paper/projects"
          class="text-orange-500 hover:text-orange-400"
        >
          View All →
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          featuredProjects.map((project: any) => (
            <a
              href={project.link}
              target="_blank"
              class="rounded-xl border border-gray-700 p-6 transition hover:border-orange-500"
            >
              <h3 class="text-xl font-bold">
                {project.title}
              </h3>

              <p class="mt-3 text-gray-400">
                {project.desc}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>